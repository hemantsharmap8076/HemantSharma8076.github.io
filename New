    function setFilter(filter) {
      activeFilter = filter;
      document.querySelectorAll('.filter-btn').forEach(btn => {
        if (btn.getAttribute('data-filter') === filter) {
          btn.className = 'filter-btn text-xs px-3 py-1 rounded-full font-medium transition bg-blue-600 text-white';
        } else {
          btn.className = 'filter-btn text-xs px-3 py-1 rounded-full font-medium transition bg-slate-900 text-slate-400 hover:text-white border border-slate-800';
        }
      });
      renderPublicProjects();
    }

    // Render Public Grid
    function renderPublicProjects() {
      const grid = document.getElementById('projectsGrid');
      const filtered = activeFilter === 'All'
        ? projects
        : projects.filter(p => (p.category || '').toLowerCase() === activeFilter.toLowerCase());

      const liveCount = projects.filter(p => (p.category || '') === 'Live').length;
      document.getElementById('statProjectsCount').innerText = projects.length;
      document.getElementById('statLiveCount').innerText = liveCount;
      document.getElementById('projectBadgeTotal').innerText = `${projects.length} Apps`;

      if (filtered.length === 0) {
