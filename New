          </div>
          <div class="flex items-center space-x-2">
            <button onclick="editProject('${escapeHtml(p.id)}')" class="p-2 text-slate-400 hover:text-blue-400 rounded-lg hover:bg-slate-800 transition">
              <i data-lucide="edit-3" class="w-4 h-4"></i>
            </button>
            <button onclick="deleteProject('${escapeHtml(p.id)}')" class="p-2 text-slate-400 hover:text-red-400 rounded-lg hover:bg-slate-800 transition">
              <i data-lucide="trash-2" class="w-4 h-4"></i>
            </button>
          </div>
        </div>
      `).join('');

      lucide.createIcons();
    }

    // Modal Operations
    function openProjectModal(editId = null) {
      const modal = document.getElementById('projectModal');
      const form = document.getElementById('projectForm');
      form.reset();
      document.getElementById('formProjectId').value = '';

      if (editId) {
        const item = projects.find(p => p.id === editId);
        if (item) {
          document.getElementById('modalTitle').innerText = 'Edit iOS App';
          document.getElementById('formProjectId').value = item.id;
          document.getElementById('formTitle').value = item.title;
          document.getElementById('formCategory').value = item.category === 'In Development' ? 'In Development' : 'Live';
          document.getElementById('formDomain').value = item.domain || '';
          document.getElementById('formImpact').value = item.impact || '';
          document.getElementById('formDesc').value = item.desc;
          document.getElementById('formTech').value = Array.isArray(item.tech) ? item.tech.join(', ') : item.tech;
          document.getElementById('formAppStore').value = item.appStore || '';
          document.getElementById('formGithub').value = item.github || '';
          document.getElementById('formImage').value = item.image || '';
        }
      } else {
        document.getElementById('modalTitle').innerText = 'Add New iOS App';
      }
      modal.classList.remove('hidden');
    }

    function closeProjectModal() {
      document.getElementById('projectModal').classList.add('hidden');
    }

    function saveProject(e) {
      e.preventDefault();
      const id = document.getElementById('formProjectId').value || Date.now().toString();
      const title = document.getElementById('formTitle').value;
      const category = document.getElementById('formCategory').value;
      const domain = document.getElementById('formDomain').value;
      const impact = document.getElementById('formImpact').value;
      const desc = document.getElementById('formDesc').value;
      const tech = document.getElementById('formTech').value.split(',').map(s => s.trim()).filter(Boolean);
      const appStore = document.getElementById('formAppStore').value;
      const github = document.getElementById('formGithub').value;
      const image = document.getElementById('formImage').value;

      const fileInput = document.getElementById('formImageFile');
      if (fileInput.files && fileInput.files[0]) {
        const reader = new FileReader();
        reader.onload = function(evt) {
          saveProjectData(id, title, category, domain, impact, desc, tech, appStore, github, evt.target.result);
        };
        reader.readAsDataURL(fileInput.files[0]);
      } else {
        saveProjectData(id, title, category, domain, impact, desc, tech, appStore, github, image);
      }
    }

    function saveProjectData(id, title, category, domain, impact, desc, tech, appStore, github, image) {
      const existingIdx = projects.findIndex(p => p.id === id);
      const payload = { id, title, category, domain, impact, desc, tech, appStore, github, image };

      if (existingIdx >= 0) {
        projects[existingIdx] = payload;
        showToast('App details updated');
      } else {
        projects.unshift(payload);
        showToast('New app successfully added');
      }

      persistProjects();
      closeProjectModal();
      renderAdminProjects();
    }

    function editProject(id) {
      openProjectModal(id);
    }

    function deleteProject(id) {
      projects = projects.filter(p => p.id !== id);
      persistProjects();
      renderAdminProjects();
      showToast('App removed');
    }

    // ===================== CONTACT FORM =====================
    let contactPromptTimer = null;

    function openContactModal(source) {
      dismissVisitorPrompt(true);
      const modal = document.getElementById('contactModal');
      document.getElementById('contactSuccess').classList.add('hidden');
      document.getElementById('contactForm').classList.remove('hidden');
      hideContactError();
      modal.classList.remove('hidden');
      lucide.createIcons();
      setTimeout(() => document.getElementById('contactName')?.focus(), 150);
    }

    function closeContactModal() {
      document.getElementById('contactModal').classList.add('hidden');
    }

    function handleContactBackdrop(event) {
      if (event.target === event.currentTarget) closeContactModal();
    }

    function showContactError(msg) {
      const el = document.getElementById('contactError');
      el.innerText = msg;
      el.classList.remove('hidden');
    }

    function hideContactError() {
      document.getElementById('contactError').classList.add('hidden');
    }

    function isValidEmail(value) {
      return /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(value);
    }

    function mailtoFallback(data) {
      const subject = `Portfolio enquiry: ${data.reason} — ${data.name}`;
      const body =
        `Name: ${data.name}\n` +
        `Email: ${data.email}\n` +
        (data.company ? `Company: ${data.company}\n` : '') +
        `About: ${data.reason}\n\n` +
        `${data.message}\n`;
      window.location.href = `mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    }

    async function submitContactForm(event) {
      event.preventDefault();
      hideContactError();

      // Honeypot — bots tick hidden fields, people don't.
      if (document.getElementById('contactBotcheck').checked) return;

      const data = {
        name: document.getElementById('contactName').value.trim(),
        email: document.getElementById('contactEmail').value.trim(),
        company: document.getElementById('contactCompany').value.trim(),
        reason: document.getElementById('contactReason').value,
        message: document.getElementById('contactMessage').value.trim()
      };

      if (!data.name) return showContactError('Please add your name.');
      if (!isValidEmail(data.email)) return showContactError('Please check your email address — I need it to reply.');
      if (data.message.length < 10) return showContactError('Please add a line or two about what you need.');

      const btn = document.getElementById('contactSubmitBtn');

      // No form service configured yet: hand off to the visitor's email app.
      if (!WEB3FORMS_ACCESS_KEY) {
        mailtoFallback(data);
        showToast('Opening your email app...');
        return;
      }

      btn.disabled = true;
      btn.innerText = 'Sending...';

      try {
        const res = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({
            access_key: WEB3FORMS_ACCESS_KEY,
            subject: `Portfolio enquiry: ${data.reason} — ${data.name}`,
            from_name: 'Portfolio contact form',
            name: data.name,
            email: data.email,
            company: data.company || 'Not given',
            reason: data.reason,
            message: data.message
          })
        });
        const result = await res.json();

        if (res.ok && result.success) {
          document.getElementById('contactForm').classList.add('hidden');
          document.getElementById('contactSuccess').classList.remove('hidden');
          document.getElementById('contactForm').reset();
          lucide.createIcons();
          showToast('Message sent — thanks!');
        } else {
          showContactError("That didn't go through. You can email me directly at " + CONTACT_EMAIL + '.');
        }
      } catch (err) {
        showContactError('No connection. Please try again, or email me at ' + CONTACT_EMAIL + '.');
      } finally {
        btn.disabled = false;
        btn.innerText = 'Send message';
      }
    }

    // ---- First-visit prompt ----
    function hasSeenVisitorPrompt() {
      try { return localStorage.getItem(VISITOR_PROMPT_KEY) === '1'; }
      catch (e) { return false; }
    }

    function markVisitorPromptSeen() {
      try { localStorage.setItem(VISITOR_PROMPT_KEY, '1'); } catch (e) {}
    }

    function showVisitorPrompt() {
      if (VISITOR_PROMPT_OPENS_FORM) {
        markVisitorPromptSeen();
        openContactModal('auto');
        return;
      }
      const el = document.getElementById('visitorPrompt');
      el.classList.remove('hidden');
      requestAnimationFrame(() => el.classList.remove('translate-y-6', 'opacity-0'));
      markVisitorPromptSeen();
      lucide.createIcons();
    }

    function dismissVisitorPrompt(silent) {
      if (contactPromptTimer) { clearTimeout(contactPromptTimer); contactPromptTimer = null; }
      const el = document.getElementById('visitorPrompt');
      if (!el || el.classList.contains('hidden')) return;
      el.classList.add('translate-y-6', 'opacity-0');
      setTimeout(() => el.classList.add('hidden'), 400);
      markVisitorPromptSeen();
    }

    function scheduleVisitorPrompt() {
      const isAdmin = (window.location.hash === '#admin') || window.location.search.includes('admin');
      if (isAdmin || !VISITOR_PROMPT_DELAY_SECONDS || hasSeenVisitorPrompt()) return;
      contactPromptTimer = setTimeout(showVisitorPrompt, VISITOR_PROMPT_DELAY_SECONDS * 1000);
    }

    // Init
    window.addEventListener('hashchange', checkRoute);
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeContactModal();
        closeProjectModal();
      }
    });
    window.addEventListener('DOMContentLoaded', () => {
      checkRoute();
      lucide.createIcons();
      scheduleVisitorPrompt();
    });
  </script>
</body>
</html>
