    let projects = loadProjects();
    let activeFilter = 'All';
    let isAdminAuthenticated = false;

    function loadProjects() {
      try {
        const saved = JSON.parse(localStorage.getItem(STORAGE_KEY));
        if (Array.isArray(saved) && saved.length) return saved;
      } catch (e) { /* ignore unreadable storage */ }
      return defaultProjects;
    }

    function persistProjects() {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(projects));
      } catch (e) { /* storage may be unavailable */ }
    }

    function resetToDefaults() {
      projects = defaultProjects.slice();
      try { localStorage.removeItem(STORAGE_KEY); } catch (e) {}
      renderAdminProjects();
      showToast('Reset to the apps published with the site');
    }

    function escapeHtml(str) {
      return String(str == null ? '' : str)
        .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
    }

    // Lettermark from the brand word: camel-case caps (DeliverIt -> DI), else first two letters.
    function initialsOf(title) {
      const brand = String(title || '')
        .split(':')[0]
        .replace(/[^A-Za-z ]/g, ' ')
        .trim().split(/\s+/)[0] || '';
      if (!brand) return 'iOS';
      const caps = brand.match(/[A-Z]/g) || [];
      if (caps.length >= 2) return caps.slice(0, 2).join('');
      return brand.slice(0, 2).toUpperCase();
    }

    // Toast
    function showToast(message) {
      const toast = document.getElementById('toast');
      document.getElementById('toastMsg').innerText = message;
      toast.classList.remove('translate-y-20', 'opacity-0', 'pointer-events-none');
      setTimeout(() => {
        toast.classList.add('translate-y-20', 'opacity-0', 'pointer-events-none');
      }, 3000);
    }

    // Share Link
    function copyCurrentShareLink() {
      const url = window.location.origin + window.location.pathname + '#portfolio';
      navigator.clipboard.writeText(url).then(() => {
        showToast('Portfolio link copied to clipboard!');
      }).catch(() => {
        showToast('Copied: ' + url);
      });
    }

    function scrollToContact() {
      document.getElementById('contactSection').scrollIntoView({ behavior: 'smooth' });
    }

    // Router
    function checkRoute() {
      const hash = window.location.hash || '#portfolio';
      const isParamAdmin = window.location.search.includes('admin');

      const publicNavbar = document.getElementById('publicNavbar');
      const adminHeader = document.getElementById('adminHeader');
      const publicView = document.getElementById('publicView');
      const adminView = document.getElementById('adminView');

      if (hash === '#admin' || isParamAdmin) {
        publicNavbar.classList.add('hidden');
        publicView.classList.add('hidden');
        adminHeader.classList.remove('hidden');
        adminView.classList.remove('hidden');

        if (!isAdminAuthenticated) {
          document.getElementById('pinLockModal').classList.remove('hidden');
          document.getElementById('adminContent').classList.add('hidden');
          setTimeout(() => document.getElementById('adminPinInput')?.focus(), 200);
        } else {
          document.getElementById('pinLockModal').classList.add('hidden');
          document.getElementById('adminContent').classList.remove('hidden');
          renderAdminProjects();
        }
      } else {
        publicNavbar.classList.remove('hidden');
        publicView.classList.remove('hidden');
        adminHeader.classList.add('hidden');
        adminView.classList.add('hidden');
        renderPublicProjects();
      }
      lucide.createIcons();
    }

    // Admin PIN (convenience lock only — this is a public page, not real security)
    function verifyAdminPin() {
      const pin = document.getElementById('adminPinInput').value;
      if (pin === '8076') {
        isAdminAuthenticated = true;
        document.getElementById('pinError').classList.add('hidden');
        document.getElementById('pinLockModal').classList.add('hidden');
        document.getElementById('adminContent').classList.remove('hidden');
        renderAdminProjects();
        showToast('Admin Studio Unlocked');
      } else {
        document.getElementById('pinError').classList.remove('hidden');
      }
    }

